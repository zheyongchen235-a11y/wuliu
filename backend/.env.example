# 后端配置示例
# 拷贝为 .env 后按需修改

# 调试模式
SCHED_DEBUG=false

# 数据库（默认 SQLite，本地演示用；生产环境改用 PostgreSQL）
SCHED_DATABASE_URL=postgresql+psycopg2://sched:sched123@postgres:5432/scheduling
# SCHED_DATABASE_URL=sqlite:///./data.db

# Redis（可选）
SCHED_REDIS_URL=redis://redis:6379/0

# LLM 配置（默认 mock 本地规则化解释）
SCHED_LLM_PROVIDER=mock
# SCHED_LLM_PROVIDER=openai
# SCHED_LLM_API_KEY=sk-xxx
# SCHED_LLM_BASE_URL=https://api.openai.com/v1
# SCHED_LLM_MODEL=gpt-4o-mini

# DeepSeek（OpenAI 兼容接口）
# 方式一：在此设置 SCHED_LLM_PROVIDER=deepseek，key/base 自动读取系统环境变量 DEEPSEEK_API_KEY / DEEPSEEK_API_BASE
# SCHED_LLM_PROVIDER=deepseek
# SCHED_LLM_MODEL=deepseek-chat
# 方式二：直接显式指定（不依赖系统环境变量）
# SCHED_LLM_API_KEY=sk-xxx
# SCHED_LLM_BASE_URL=https://api.deepseek.com
# SCHED_LLM_MODEL=deepseek-chat

# TMS 集成
SCHED_TMS_BASE_URL=http://localhost:8000/mock/tms

# 微信小程序登录（未配置 AppID 时由 code 派生 mock openid，本地联调免证书）
# WX_APP_ID=wx1234567890abcdef
# WX_APP_SECRET=your_app_secret
# SCHED_WX_MOCK_LOGIN=true

# 求解器
SCHED_SOLVER_TIME_LIMIT_SEC=5
