/* app.wxss —— 全局样式（主色 #1e3c72） */
page {
  background-color: #f4f6fb;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1f2430;
  font-size: 28rpx;
  line-height: 1.5;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

/* ---------- 通用容器 ---------- */
.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(30, 60, 114, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title .sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #9aa1b0;
}

/* ---------- 文本 ---------- */
.muted {
  color: #9aa1b0;
  font-size: 24rpx;
}

.strong {
  font-weight: 600;
}

.price {
  color: #e8503a;
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 主按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-primary.btn-disabled {
  background: #c8cdd8;
  color: #ffffff;
}

.btn-ghost {
  background: #ffffff;
  color: #1e3c72;
  border: 2rpx solid #1e3c72;
  border-radius: 44rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 84rpx;
  text-align: center;
}

.btn-ghost::after {
  border: none;
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 0 32rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #eef2fb;
  color: #2a5298;
}

/* ---------- 空态 / 加载 ---------- */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #9aa1b0;
  font-size: 26rpx;
}

.empty .empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

/* ---------- 分隔 ---------- */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.divider {
  height: 1rpx;
  background: #eef0f5;
  margin: 24rpx 0;
}

/* ---------- 表单行 ---------- */
.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eef0f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  color: #5b6274;
  font-size: 28rpx;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  text-align: right;
  color: #1f2430;
  font-size: 28rpx;
}

.form-value.placeholder {
  color: #b9bfcc;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1f2430;
}