<!-- pages/index/index.wxml -->
<view class="header">
  <view class="greet">{{greeting}}，{{user.nickname || '店主'}}</view>
  <view class="sub">今天也要顺利送达 · 共 {{storeCount}} 家门店可配送</view>
</view>

<view class="stat-card">
  <view class="stat-item">
    <view class="num warn">{{stats.pending_pay}}</view>
    <view class="label">待支付</view>
  </view>
  <view class="stat-item">
    <view class="num">{{stats.scheduled}}</view>
    <view class="label">已排车</view>
  </view>
  <view class="stat-item">
    <view class="num">{{stats.delivering}}</view>
    <view class="label">配送中</view>
  </view>
  <view class="stat-item">
    <view class="num ok">{{stats.completed}}</view>
    <view class="label">已完成</view>
  </view>
</view>

<view class="quick-row">
  <view class="quick-item" bindtap="goCreate">
    <text class="icon">📦</text>
    <text class="text">立即下单</text>
  </view>
  <view class="quick-item" bindtap="goOrders">
    <text class="icon">📋</text>
    <text class="text">我的订单</text>
  </view>
  <view class="quick-item" bindtap="goPayments">
    <text class="icon">💰</text>
    <text class="text">支付流水</text>
  </view>
</view>

<view class="card" style="margin-top: 0;">
  <view class="card-title">
    <text>常用门店</text>
    <text class="sub" bindtap="goCreate">全部 ›</text>
  </view>
  <view wx:if="{{stores.length === 0}}" class="empty">
    <text class="empty-icon">🏬</text>
    <text>暂无可用门店</text>
  </view>
  <view
    wx:for="{{stores}}"
    wx:key="id"
    class="store-item"
    data-id="{{item.id}}"
    bindtap="pickStore"
  >
    <view class="store-avatar">{{item.shortName}}</view>
    <view class="store-body">
      <view class="name ellipsis">{{item.name}}</view>
      <view class="addr ellipsis">{{item.address || '暂无地址'}} · {{item.timeText}}</view>
    </view>
    <view class="store-go">去下单 ›</view>
  </view>
</view>

<view class="card">
  <view class="card-title">
    <text>最近订单</text>
    <text class="sub" bindtap="goOrders">查看全部 ›</text>
  </view>
  <view wx:if="{{recentOrders.length === 0}}" class="empty">
    <text class="empty-icon">📭</text>
    <text>还没有订单，去下一单吧</text>
  </view>
  <view
    wx:for="{{recentOrders}}"
    wx:key="id"
    class="order-item"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="order-top">
      <text class="order-store ellipsis">{{item.store_name}}</text>
      <text class="status-pill" style="color:{{item.status_color}};background:{{item.status_bg}};">{{item.status_text}}</text>
    </view>
    <view class="order-bottom">
      <text class="order-no">{{item.order_no}}</text>
      <text class="price">{{item.amount_text}}</text>
    </view>
    <view class="order-bottom" style="margin-top: 6rpx;">
      <text class="order-meta">{{item.cargo_text}} · {{item.weight}}kg · {{item.window_text}}</text>
      <text class="order-meta">{{item.created_text}}</text>
    </view>
  </view>
</view>