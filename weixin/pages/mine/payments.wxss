/* pages/mine/payments.wxss */
.summary {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  display: flex;
}

.summary-item {
  flex: 1;
}

.summary-item .label {
  font-size: 24rpx;
  opacity: 0.82;
}

.summary-item .num {
  font-size: 44rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

.pay-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 60, 114, 0.07);
}

.pay-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pay-channel {
  font-size: 29rpx;
  font-weight: 500;
}

.pay-amount {
  font-size: 34rpx;
  font-weight: 600;
  color: #e8503a;
}

.pay-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #8a90a0;
  margin-top: 14rpx;
}

.status-success {
  color: #2f9e44;
}

.status-refunded {
  color: #c78a00;
}