/* pages/mine/mine.wxss */
.user-card {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  margin-right: 28rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-body {
  flex: 1;
  min-width: 0;
}

.user-body .name {
  font-size: 36rpx;
  font-weight: 600;
}

.user-body .sub {
  font-size: 23rpx;
  opacity: 0.8;
  margin-top: 10rpx;
}

.grid {
  display: flex;
}

.grid-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
}

.grid-item .num {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e3c72;
}

.grid-item .label {
  font-size: 23rpx;
  color: #8a90a0;
  margin-top: 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eef0f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #eef2fb;
  color: #2a5298;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 29rpx;
}

.menu-arrow {
  color: #c8cdd8;
  font-size: 26rpx;
}

.logout {
  margin-top: 32rpx;
}