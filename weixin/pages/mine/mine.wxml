<!-- pages/mine/mine.wxml -->
<view class="page">
  <view class="user-card">
    <view class="avatar">
      <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
      <text wx:else>{{initial}}</text>
    </view>
    <view class="user-body">
      <view class="name ellipsis">{{user.nickname || '微信用户'}}</view>
      <view class="sub">openid：{{shortOpenid}}</view>
      <view class="sub">{{user.phone ? '手机号 ' + user.phone : '未绑定手机号'}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">
      <text>我的订单</text>
      <text class="sub" bindtap="goOrders">全部 ›</text>
    </view>
    <view class="grid">
      <view class="grid-item" data-status="pending_pay" bindtap="goOrdersWithStatus">
        <view class="num">{{stats.pending_pay}}</view>
        <view class="label">待支付</view>
      </view>
      <view class="grid-item" data-status="paid" bindtap="goOrdersWithStatus">
        <view class="num">{{stats.paid}}</view>
        <view class="label">待调度</view>
      </view>
      <view class="grid-item" data-status="scheduled" bindtap="goOrdersWithStatus">
        <view class="num">{{stats.scheduled}}</view>
        <view class="label">已排车</view>
      </view>
      <view class="grid-item" data-status="completed" bindtap="goOrdersWithStatus">
        <view class="num">{{stats.completed}}</view>
        <view class="label">已完成</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title"><text>功能</text></view>
    <view class="menu-item" bindtap="goPayments">
      <view class="menu-icon">💰</view>
      <view class="menu-text">支付流水</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="editNickname">
      <view class="menu-icon">✏️</view>
      <view class="menu-text">修改昵称</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="editPhone">
      <view class="menu-icon">📱</view>
      <view class="menu-text">绑定手机号</view>
      <view class="menu-arrow">{{user.phone || '未绑定'}} ›</view>
    </view>
    <view class="menu-item" bindtap="refreshProfile">
      <view class="menu-icon">🔄</view>
      <view class="menu-text">刷新资料</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <button class="btn-ghost logout" bindtap="logout">退出登录</button>
</view>