/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(170deg, #1e3c72 0%, #2a5298 46%, #f4f6fb 46%, #f4f6fb 100%);
  padding: 0 48rpx;
}

.brand {
  padding: 90rpx 0 70rpx;
  color: #ffffff;
}

.brand-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-bottom: 36rpx;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.brand-sub {
  font-size: 26rpx;
  opacity: 0.82;
  margin-top: 14rpx;
}

.login-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 56rpx;
  box-shadow: 0 16rpx 48rpx rgba(30, 60, 114, 0.14);
}

.login-card-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.login-card-desc {
  font-size: 25rpx;
  color: #9aa1b0;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.feature {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eef2fb;
  color: #2a5298;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.feature-text {
  flex: 1;
}

.feature-text .t {
  font-size: 28rpx;
  font-weight: 500;
}

.feature-text .d {
  font-size: 23rpx;
  color: #9aa1b0;
  margin-top: 4rpx;
}

.login-btn {
  margin-top: 40rpx;
}

.login-tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 23rpx;
  color: #9aa1b0;
  line-height: 1.7;
}

.wx-icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  margin-right: 14rpx;
  vertical-align: middle;
}