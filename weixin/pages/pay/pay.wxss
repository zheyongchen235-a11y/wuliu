/* pages/pay/pay.wxss */
.pay-hero {
  background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
  border-radius: 24rpx;
  padding: 60rpx 36rpx;
  color: #ffffff;
  text-align: center;
  margin-bottom: 24rpx;
}

.pay-hero .label {
  font-size: 25rpx;
  opacity: 0.82;
}

.pay-hero .amount {
  font-size: 76rpx;
  font-weight: 600;
  margin-top: 16rpx;
  letter-spacing: 2rpx;
}

.pay-hero .no {
  font-size: 23rpx;
  opacity: 0.7;
  margin-top: 18rpx;
}

.method {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eef0f5;
}

.method:last-child {
  border-bottom: none;
}

.method-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.method-icon.wx {
  background: #e8f8ee;
  color: #07c160;
}

.method-icon.balance {
  background: #eef2fb;
  color: #2a5298;
}

.method-body {
  flex: 1;
}

.method-body .t {
  font-size: 29rpx;
  font-weight: 500;
}

.method-body .d {
  font-size: 23rpx;
  color: #9aa1b0;
  margin-top: 4rpx;
}

.radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d5dbeb;
  flex-shrink: 0;
}

.radio.on {
  border-color: #1e3c72;
  background: radial-gradient(circle, #1e3c72 0%, #1e3c72 46%, #ffffff 52%, #ffffff 100%);
}

.pay-btn {
  margin-top: 40rpx;
}

.tip {
  text-align: center;
  color: #9aa1b0;
  font-size: 23rpx;
  margin-top: 26rpx;
  line-height: 1.7;
}

.success-box {
  text-align: center;
  padding: 80rpx 40rpx;
}

.success-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #e8f7ec;
  color: #2f9e44;
  font-size: 70rpx;
  line-height: 140rpx;
  margin: 0 auto 32rpx;
}

.success-title {
  font-size: 38rpx;
  font-weight: 600;
}

.success-desc {
  font-size: 25rpx;
  color: #9aa1b0;
  margin-top: 16rpx;
  line-height: 1.7;
}